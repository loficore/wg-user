# =============================================================================
# wg-user obfuscation transport — configuration reference
# =============================================================================
# wstunnel docs: https://github.com/erebe/wstunnel
#
# Recommended VPS setup (see docs/TUNNEL-SERVER.md):
#   wstunnel server wss://0.0.0.0:443 --restrict-to 127.0.0.1:51820
# (with a normal wireguard daemon on 127.0.0.1:51820 of the VPS)
#
# Parsing rules (wg-user): flat key=value, the FIRST occurrence of a key
# wins, and a value must NOT be followed by a trailing comment — the parser
# keeps it as part of the value.
# =============================================================================

# mode must be "off" or "wstunnel". Any other value is treated as off.
mode = off

[wstunnel]
# Local UDP listener. wireproxy's [Peer] Endpoint must equal this.
local-udp = 127.0.0.1:51820

# Where the SERVER forwards to (seen from the server, i.e. its own loopback
# WireGuard listener). Defaults to 127.0.0.1:51820.
# remote-udp = 127.0.0.1:51820

# Remote server. Options:
#   wss://host:443   WebSocket over TLS (recommended, HTTPS-disguised)
#   ws://host:port   plain WebSocket (only inside a trusted LAN)
#   wts://host:443   WebTransport over QUIC (needs UDP open end-to-end)
# remote = wss://your-server.com:443

# Optional basic auth for the WebSocket upgrade request (both are needed).
# username = myuser
# password = mypassword

# Certificate verification. wstunnel verifies the server certificate only
# when this is explicitly set to false; the default (absent / true) accepts
# the self-signed certificate wstunnel embeds.
# insecure = false
