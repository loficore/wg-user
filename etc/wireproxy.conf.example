# =============================================================================
# wg-user / wireproxy configuration reference
# =============================================================================
# This file follows the wireproxy INI format. The required sections are
# [Interface] and [Peer]; at least one of [Socks5], [HTTP], or [TCPClientTunnel]
# must be present to actually accept traffic.
#
# All string values may reference environment variables: $MY_VAR.
# Use $$ to escape a literal $ (e.g. for a password containing $).
#
# Most fields are case-insensitive. Section names are case-sensitive.
# =============================================================================

# === [Interface] — this client ===
[Interface]
# Required. The IPv4 (/32) and/or IPv6 (/128) address inside the WG network.
Address = 10.0.0.2/32
# Required. Base64-encoded private key for this client. Keep this SECRET.
# Generate with: wg genkey | tee privatekey | wg pubkey > publickey
PrivateKey = <base64>
# Optional. DNS servers reachable through the tunnel. Used by wireproxy for
# the WG endpoint hostname (e.g. if Endpoint is a hostname).
DNS = 10.0.0.1
# Optional. Default 1420.
# MTU = 1420

# === [Peer] — the remote WG server ===
[Peer]
# Required. Base64-encoded public key of the remote peer.
PublicKey = <base64>
# Required. host:port used for the WireGuard UDP traffic:
# - Mode = off (the default): the remote WireGuard server's UDP port.
# - Mode = wstunnel: the address the wstunnel SERVER forwards to, as seen from
#   the server (its own loopback WireGuard listener, normally
#   127.0.0.1:51820). The client's local UDP socket no longer exists; the
#   transport is in-process.
Endpoint = wireguard.example.com:51820
# Optional. Pre-shared key (extra layer of post-quantum-ready symmetric key).
# PresharedKey =
# Optional. Default 0 (off). 25 is a sensible value on mobile networks.
PersistentKeepalive = 25
# Optional but important. AllowedIPs is the allowlist of CIDRs the SOCKS5
# clients can reach THROUGH this peer. To allow all: 0.0.0.0/0, ::/0
AllowedIPs = 0.0.0.0/0

# === [Transport] — optional wstunnel obfuscation ===
# Without a [Transport] section (or with Mode = off) the WireGuard UDP packets
# go straight to [Peer] Endpoint. Mode = wstunnel wraps them in WebSocket/TLS
# to survive networks that block UDP; see docs/TUNNEL-SERVER.md. 0.3.0 reads
# this section instead of the old etc/tunnel.conf, which the installer
# migrates automatically.
[Transport]
# "off" (default) or "wstunnel".
Mode = off
# Required when Mode = wstunnel. wstunnel server URL; scheme ws or wss.
# URL = wss://your-server.com:443
# Optional. WebSocket upgrade path prefix. Default v1.
# Path = v1
# Optional. Seconds between WebSocket keepalive pings; 0 disables. Default 25.
# Keepalive = 25
# Optional. Basic auth for the upgrade request; send both or neither.
# Username = myuser
# Password = mypassword
# Optional. true skips TLS certificate verification (self-signed servers);
# false, the default, verifies the server certificate.
# Insecure = false

# === One or more of these inbound sections ===
[Socks5]
BindAddress = 127.0.0.1:1080
# Optional. If set, SOCKS5 auth is required.
# Username = user
# Password = pass

# [HTTP]
# BindAddress = 127.0.0.1:8080
# Username = user
# Password = pass
# CertFile = /path/to/cert.pem
# KeyFile  = /path/to/key.pem

# [TCPClientTunnel] — listen on a local port, forward to remote through WG.
# BindAddress = 127.0.0.1:3389
# Target      = remotehost:3389
