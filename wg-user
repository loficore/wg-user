#!/system/bin/sh
# wg-user — control script for the WireGuard userspace proxy module.
#
# One binary, one process: `bin/wg-user run` owns the WireGuard device and,
# when [Transport] Mode = wstunnel, the WebSocket transport as well.
#
# Top-level subcommands:
#   start                  — start the daemon in the background
#   stop                   — SIGTERM, wait up to 20s, then SIGKILL
#   restart                — stop + start
#   reload                 — configtest; on success, stop+start
#   status                 — running state + transport line from run/state
#   log [N]                — tail N lines (default 50) of log/wg-user.log
#   save-config <path>     — configtest it, copy to wireproxy.conf; the
#                            reload watcher restarts the daemon within ~5s
#   version                — module version
#
# All subcommands exit 0 on success, 1 on error, 2 on a usage error.

set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
. "$ROOT/common/util.sh"

PIDFILE="$ROOT/run/wg-user.pid"
STATEFILE="$ROOT/run/state"
LOG="$ROOT/log/wg-user.log"
CONF="$ROOT/etc/wireproxy.conf"
BIN="$ROOT/bin/wg-user"
mkdir -p "$ROOT/run" "$ROOT/log"

# How long SIGTERM gets before SIGKILL. The Go daemon may spend up to 10s
# finishing an in-flight UDP write and then rewrites the log and state file, so
# a shorter window would truncate its last output. Polled twice a second.
STOP_TIMEOUT=20
STOP_POLLS=$((STOP_TIMEOUT * 2))

# ---------- helpers ----------

# state_value <key> — echo the value of key in run/state, or nothing when the
# file is absent or lacks the key. The keys are the Go state package's contract.
state_value() {
    [ -f "$STATEFILE" ] || return 0
    sed -n "s/^$1=//p" "$STATEFILE" | head -n 1
}

# wait_for_exit <pid> — 0 once the process is gone, 1 if it outlived the window.
wait_for_exit() {
    i=0
    while [ "$i" -lt "$STOP_POLLS" ]; do
        kill -0 "$1" 2>/dev/null || return 0
        sleep 0.5
        i=$((i + 1))
    done
    ! kill -0 "$1" 2>/dev/null
}

# pid_is_wguser <pid> — 0 when /proc/<pid>/cmdline is this module's daemon.
# A pidfile on /data/adb outlives crashes, and after an unclean reboot the pid
# may belong to a completely unrelated process; never trust or signal it
# without this check. An unreadable cmdline fails closed (pid is not ours).
#
# Only argv[0] and argv[1] are compared. The real daemon is launched as
# "$BIN" run -c … (argv[0]); a shebang script shows the interpreter in argv[0]
# and the script path in argv[1]. Comparing those two positions — rather than
# "the path appears somewhere in argv" — keeps a stranger that merely carries
# the path as an argument (`sh -c 'sleep 300' _ "$BIN"`, where it lands after
# argv[1]) from being adopted and signalled.
pid_is_wguser() {
    [ -r "/proc/$1/cmdline" ] || return 1
    _argv0=$(tr '\0' '\n' < "/proc/$1/cmdline" 2>/dev/null | sed -n '1p')
    _argv1=$(tr '\0' '\n' < "/proc/$1/cmdline" 2>/dev/null | sed -n '2p')
    [ "$_argv0" = "$BIN" ] || [ "$_argv1" = "$BIN" ]
}

# running_pid — echo the pidfile's pid iff it is alive and is our daemon.
# Returns 1, printing nothing, for a missing, stale or reused pidfile.
running_pid() {
    [ -f "$PIDFILE" ] || return 1
    _pid=$(cat "$PIDFILE" 2>/dev/null) || return 1
    [ -n "$_pid" ] || return 1
    kill -0 "$_pid" 2>/dev/null || return 1
    pid_is_wguser "$_pid" || return 1
    echo "$_pid"
}

# ---------- lifecycle ----------

cmd_start() {
    if pid=$(running_pid); then
        log_info "wg-user already running (pid $pid)"
        return 0
    fi
    if [ ! -x "$BIN" ]; then
        log_err "binary not installed: $BIN. Run 'customize.sh' or 'install.sh'."
        return 1
    fi
    if [ ! -f "$CONF" ]; then
        log_err "config not found: $CONF"
        return 1
    fi

    log_info "starting wg-user..."
    nohup "$BIN" run -c "$CONF" > "$LOG" 2>&1 &
    pid=$!
    # temp + rename, like internal/state: the WebUI polls status every 5s and
    # must never read a half-written pidfile.
    printf '%s\n' "$pid" > "$PIDFILE.tmp" && mv -f "$PIDFILE.tmp" "$PIDFILE"

    if [ -e "/proc/$pid/oom_score_adj" ]; then
        echo -1000 > "/proc/$pid/oom_score_adj" 2>/dev/null \
            && log_info "set oom_score_adj=-1000" \
            || log_warn "could not set oom_score_adj (non-fatal)"
    fi

    sleep 1
    if ! running_pid >/dev/null; then
        log_err "wg-user exited immediately. Last log:"
        tail -n 20 "$LOG" >&2
        rm -f "$PIDFILE"
        return 1
    fi
    log_info "wg-user started (pid $pid). Logs: $LOG"
}

cmd_stop() {
    if ! pid=$(running_pid); then
        # Gone, or a pidfile naming a stranger: dropping the file is safe,
        # signalling it is not.
        rm -f "$PIDFILE"
        log_info "wg-user not running"
        return 0
    fi
    log_info "stopping wg-user (pid $pid)..."
    kill -TERM "$pid" 2>/dev/null || true

    if wait_for_exit "$pid"; then
        log_info "wg-user stopped"
    else
        log_warn "wg-user did not exit within ${STOP_TIMEOUT}s; sending SIGKILL"
        kill -KILL "$pid" 2>/dev/null || true
        # Give the kernel a moment to reap it, then refuse to report success
        # for a process that survived SIGKILL (e.g. uninterruptible sleep).
        i=0
        while [ "$i" -lt 10 ] && kill -0 "$pid" 2>/dev/null; do
            sleep 0.1
            i=$((i + 1))
        done
        if kill -0 "$pid" 2>/dev/null; then
            # Keep the pidfile: the process is still tracked, and the next stop
            # retries instead of losing it.
            log_err "wg-user (pid $pid) survived SIGKILL"
            return 1
        fi
        log_info "wg-user killed"
    fi
    rm -f "$PIDFILE"
    return 0
}

cmd_restart() {
    cmd_stop
    cmd_start
}

cmd_reload() {
    if [ ! -f "$CONF" ]; then
        log_err "no config at $CONF"
        return 1
    fi
    if [ ! -x "$BIN" ]; then
        log_err "binary not installed: $BIN"
        return 1
    fi
    log_info "configtest $CONF"
    # configtest explains a bad file on stderr; its "Config OK" is noise here.
    if ! "$BIN" configtest -c "$CONF" >/dev/null; then
        log_err "configtest FAILED; not reloading. See $LOG for details."
        return 1
    fi
    log_info "config OK; restarting"
    cmd_restart
}

# ---------- reporting ----------

cmd_status() {
    # A stale or reused pidfile means the process is not ours; run/state is
    # only meaningful while the pid it belongs to is alive and is ours.
    if ! pid=$(running_pid); then
        log_info "wg-user: stopped"
        return 1
    fi

    log_info "wg-user: running (pid $pid)"
    if [ -f "$LOG" ]; then
        log_info "last log: $(tail -n 1 "$LOG")"
    fi

    # The daemon moves itself out of the app cgroup it was started from (the
    # WebUI runs inside the KernelSU app, whose cgroup Android freezes when it
    # is backgrounded). A process that is still inside one is alive but
    # stopped: its transport will never change again. Say so instead of
    # reporting a state file that only looks like a live transport.
    _cg=$(awk -F: '$1 == "0" { print $3; exit }' "/proc/$pid/cgroup" 2>/dev/null)
    case "$_cg" in
        /uid_*)
            log_warn "daemon is in the app cgroup $_cg; Android freezes it while that app is backgrounded and the transport stops — restart to move it out"
            ;;
    esac

    # run/state carries the pid that wrote it: another daemon's transport (or a
    # file left by a dead one) must never be reported as this process's.
    if [ "$(state_value pid)" != "$pid" ]; then
        log_info "transport: unknown"
        return 0
    fi

    detail=$(state_value transport_detail)
    tstate=$(state_value transport_state)
    if [ -z "$detail" ] && [ -z "$tstate" ]; then
        log_info "transport: unknown"
    elif [ -z "$detail" ] || [ -z "$tstate" ]; then
        log_info "transport: ${detail:-unknown}${tstate:+ ($tstate)}"
    else
        log_info "transport: $detail ($tstate)"
    fi
    return 0
}

cmd_log() {
    [ "$#" -le 1 ] || { log_err "log: too many arguments (use 'log [N]')"; return 2; }
    n="${1:-50}"
    case "$n" in
        ''|*[!0-9]*) log_err "log: invalid line count '$n'"; return 2 ;;
    esac
    [ "$n" -gt 0 ] || { log_err "log: invalid line count '$n'"; return 2; }
    [ -f "$LOG" ] || { log_err "no log: $LOG"; return 1; }
    tail -n "$n" "$LOG"
}

cmd_save_config() {
    src="${1:-}"
    [ -n "$src" ] && [ -f "$src" ] || { log_err "save-config: file not found: ${src:-<none>}"; return 1; }
    if [ ! -x "$BIN" ]; then
        log_err "binary not installed: $BIN"
        return 1
    fi
    # Validate the staged file BEFORE it replaces a working config: a typo in
    # the WebUI editor must never leave etc/wireproxy.conf unparseable, and
    # configtest explains the problem on stderr. (The watcher re-runs
    # configtest before its restart, so this is not a second gate, just an
    # early one.)
    log_info "configtest $src"
    if ! "$BIN" configtest -c "$src" >/dev/null; then
        log_err "configtest FAILED; $CONF left unchanged. See the message above."
        return 1
    fi
    cp -f "$src" "$CONF"
    # The config holds the private key; customize.sh seeds it 0600 and this is
    # the one other place the script writes it.
    chmod 0600 "$CONF" 2>/dev/null \
        || log_warn "could not chmod 0600 $CONF"
    log_info "saved config to $CONF"
    # The restart belongs to the reload watcher (service.sh compares the
    # file's content signature every 5s). Restarting here too would stop+start
    # the daemon twice per save, and two concurrent restarts can leave a dead
    # pid in run/wg-user.pid while the survivor holds the port.
    log_info "the reload watcher applies it within ~5s"
}

cmd_version() {
    if [ ! -f "$ROOT/module.prop" ]; then
        log_err "no module.prop at $ROOT"
        return 1
    fi
    sed -n 's/^version=//p' "$ROOT/module.prop" | head -n 1
}

usage() {
    sed -n '2,/^$/p' "$0" | head -n 40 | sed 's/^# \{0,1\}//'
    # Return 0 so `set -e` does not abort before the caller's explicit
    # exit code is honored (e.g. `usage; exit 0` for --help).
    return 0
}

# ---------- dispatcher ----------

case "${1:-}" in
    start)        cmd_start ;;
    stop)         cmd_stop ;;
    restart)      cmd_restart ;;
    reload)       cmd_reload ;;
    status)       cmd_status ;;
    log)          shift; cmd_log "$@" ;;
    save-config)  shift; cmd_save_config "$@" ;;
    version)      cmd_version ;;
    ""|-h|--help|help) usage; exit 0 ;;
    *) log_err "unknown subcommand: $1"; usage; exit 2 ;;
esac
